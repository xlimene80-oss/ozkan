# ==============================================================================
# 13 SIGORTA - ÇEVRE DEĞİŞKENLERİ ŞABLONU (.env.example)
# Gerçek gizli anahtarları ve şifreleri buraya DEĞİL, .env dosyasına yazınız.
# ==============================================================================

# Sunucu & Port Ayarları
PORT=5000
NODE_ENV=development
FRONTEND_URL=https://13sigorta.netlify.app

# Veritabanı (Render PostgreSQL bağlantı adresi)
# Örn: postgres://user:password@hostname:5432/dbname?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sigorta_db

# Güvenlik & Tuzlama
# IP adreslerini tek yönlü tuzlu hashlemek için gizli anahtar (en az 32 karakter)
IP_HASH_SALT=your-random-secret-salt-change-in-production-min-32-chars

# Admin Paneli Şifresi ve Token İmzası
# Production'da en az 12 karakterlik güçlü şifre ve en az 32 karakterlik secret zorunludur
ADMIN_PASSWORD=change-this-to-a-very-strong-admin-password-min-12-chars
ADMIN_TOKEN_SECRET=your-random-jwt-secret-min-32-chars-for-admin-session
JWT_SECRET=your-random-jwt-secret-min-32-chars-for-admin-session

# Veri Saklama Süresi (Gün) - Otomatik temizlik görevi bu süreden eski kayıtları siler
LEAD_RETENTION_DAYS=365

# Bildirim Kanalları (virgülle çoklu: "log", "email", "whatsapp_cloud")
# Varsayılan: log
LEAD_NOTIFY_MODE=log

# ------------------------------------------------------------------------------
# E-posta Bildirim Ayarları (LEAD_NOTIFY_MODE içinde "email" varsa gereklidir)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=bildirim@13sigorta.com
SMTP_PASS=your-smtp-password
SMTP_SECURE=false
EMAIL_FROM=13 Sigorta <bildirim@13sigorta.com>
NOTIFY_EMAIL_TO=acente@13sigorta.com

# ------------------------------------------------------------------------------
# Meta WhatsApp Cloud API Ayarları (LEAD_NOTIFY_MODE içinde "whatsapp_cloud" varsa)
# DİKKAT: Meta Graph API sürümü değişken olarak verilmiştir. Meta belgelerinden
# güncel sürümü kontrol ediniz (örn. v21.0 veya v22.0).
# ------------------------------------------------------------------------------
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TOKEN=EAAB...your-meta-access-token
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_NOTIFY_TO=905551234567
WHATSAPP_TEMPLATE_NAME=teklif_talebi_bildirimi
WHATSAPP_TEMPLATE_LANG=tr
